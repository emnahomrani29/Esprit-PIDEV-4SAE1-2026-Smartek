pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'frontend'
        IMAGE_NAME     = "wafachabbi/${SERVICE_NAME}"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        CONTAINER_PORT = '80'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def isManual = currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause) != null
                    if (isManual) {
                        echo "✅ Build déclenché manuellement — pipeline lancé complet."
                    } else {
                        def changedFiles = sh(script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || echo 'ALL'", returnStdout: true).trim()
                        echo "Fichiers modifiés :\n${changedFiles}"
                        if (changedFiles == 'ALL' || changedFiles.isEmpty()) {
                            echo "✅ Pas de repo Git détecté — pipeline lancé complet."
                        } else {
                            def serviceChanged = changedFiles.split('\n').any { f -> f.startsWith('Frontend/angular-app/') }
                            if (!serviceChanged) {
                                echo "⏭️  Aucun changement dans frontend — pipeline ignoré."
                                currentBuild.result = 'NOT_BUILT'
                                error("Skipping: no changes in frontend")
                            } else {
                                echo "✅ Changements détectés dans frontend — pipeline lancé."
                            }
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('Frontend/angular-app') {
                    sh 'npm install'
                    sh 'npm run build --prod'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Frontend/angular-app') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                    /usr/bin/trivy image --exit-code 0 --severity HIGH,CRITICAL \
                        --no-progress --format table \
                        --timeout 30m \
                        --scanners vuln \
                        ${IMAGE_NAME}:${IMAGE_TAG} || true
                """
            }
        }

        stage('Docker Push') {
            steps {
                sh """
                    echo \$DOCKERHUB_CREDENTIALS_PSW | docker login -u \$DOCKERHUB_CREDENTIALS_USR --password-stdin
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                    docker logout
                """
            }
        }

        stage('Sign Docker Image') {
            steps {
                sh """
                    echo \$DOCKERHUB_CREDENTIALS_PSW | docker login -u \$DOCKERHUB_CREDENTIALS_USR --password-stdin
                    COSIGN_PASSWORD='2525' /usr/local/bin/cosign sign --key /home/wafa/cosign.key \
                        --yes docker.io/${IMAGE_NAME}:${IMAGE_TAG} || true
                    docker logout
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    kubectl apply -f k8s/namespace.yml
                    kubectl apply -f k8s/gateway-frontend.yml
                    kubectl set image deployment/frontend \
                        frontend=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n smartek
                    kubectl rollout status deployment/frontend \
                        -n smartek --timeout=10m || true
                    kubectl get pods -n smartek -l app=frontend
                """
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    echo 'Attente du démarrage du service...'
                    sleep 30
                    STATUS=\$(curl -s -o /dev/null -w '%{http_code}' http://192.168.100.138:30080/ || echo '000')
                    if [ "\$STATUS" = "200" ]; then
                        echo 'Smoke Test OK - frontend est up'
                    else
                        echo 'Smoke Test WARN - status: '\$STATUS
                    fi
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} terminé avec succès - image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} échoué - vérifier les logs"
        }
    }
}
