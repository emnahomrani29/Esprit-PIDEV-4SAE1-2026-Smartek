pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'offers-service'
        IMAGE_NAME     = "wafachabbi/${SERVICE_NAME}"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        CONTAINER_PORT = '8085'
        SONAR_URL      = 'http://192.168.100.138:9000'
        SONAR_TOKEN    = 'squ_c9036cd8db019186d870601f11f32229205d13a2'
        SONAR_PROJECT  = 'offers-service'
        NEXUS_URL      = 'http://192.168.100.138:8089'
        NEXUS_REPO     = 'maven-snapshots'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || echo 'ALL'", returnStdout: true).trim()
                    echo "Fichiers modifiés :\n${changedFiles}"
                    if (changedFiles == 'ALL' || changedFiles.isEmpty()) {
                        echo "✅ Pas de repo Git détecté — pipeline lancé complet."
                    } else {
                        def serviceChanged = changedFiles.split('\n').any { f -> f.startsWith('Backend/offers-service/') }
                        if (!serviceChanged && env.GIT_BRANCH != 'main' && env.GIT_BRANCH != 'develop') {
                            echo "⏭️  Aucun changement dans offers-service — pipeline ignoré."
                            currentBuild.result = 'NOT_BUILT'
                            error("Skipping: no changes in offers-service")
                        } else {
                            echo "✅ Changements détectés dans offers-service — pipeline lancé."
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('Backend/offers-service') {
                    sh 'mvn clean package -DskipTests --no-transfer-progress'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Backend/offers-service') {
                    sh 'mvn test --no-transfer-progress'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'Backend/offers-service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Backend/offers-service') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=${SONAR_PROJECT} \
                                -Dsonar.projectName=${SONAR_PROJECT} \
                                -Dsonar.host.url=${SONAR_URL} \
                                -Dsonar.token=${SONAR_TOKEN} \
                                --no-transfer-progress
                        """
                    }
                }
            }
        }

        stage('Push to Nexus') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                retry(2) {
                    dir('Backend/offers-service') {
                        sh """
                            mvn deploy -DskipTests \
                                -s /home/wafa/.jenkins/maven-settings.xml \
                                -DaltDeploymentRepository=nexus::http://192.168.100.138:8089/repository/maven-snapshots/ \
                                --no-transfer-progress
                        """
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Backend/offers-service') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                    /usr/bin/trivy image --exit-code 0 --severity HIGH,CRITICAL \
                        --no-progress --format table \
                        --timeout 30m \
                        --scanners vuln \
                        ${IMAGE_NAME}:${IMAGE_TAG} || true
                """
            }
        }

        stage('Docker Push') {
            steps {
                sh """
                    echo \$DOCKERHUB_CREDENTIALS_PSW | docker login -u \$DOCKERHUB_CREDENTIALS_USR --password-stdin
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                    docker logout
                """
            }
        }

        stage('Sign Docker Image') {
            steps {
                sh """
                    echo \$DOCKERHUB_CREDENTIALS_PSW | docker login -u \$DOCKERHUB_CREDENTIALS_USR --password-stdin
                    COSIGN_PASSWORD='2525' /usr/local/bin/cosign sign --key /home/wafa/cosign.key \
                        --yes docker.io/${IMAGE_NAME}:${IMAGE_TAG} || true
                    docker logout
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    kubectl apply -f k8s/namespace.yml
                    kubectl apply -f k8s/offers-service.yml
                    kubectl set image deployment/offers-service \
                        offers-service=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n smartek
                    kubectl rollout status deployment/offers-service \
                        -n smartek --timeout=10m || true
                    kubectl get pods -n smartek -l app=offers-service
                """
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    echo 'Attente du démarrage du service...'
                    sleep 60
                    STATUS=\$(curl -s -o /dev/null -w '%{http_code}' http://192.168.100.138:30090/actuator/health || echo '000')
                    if [ "\$STATUS" = "200" ]; then
                        echo 'Smoke Test OK - offers-service est up'
                    else
                        echo 'Smoke Test WARN - status: '\$STATUS
                    fi
                """
            }
        }

        stage('Verify Prometheus') {
            steps {
                sh """
                    sleep 20
                    STATUS=\$(curl -s -o /dev/null -w '%{http_code}' "http://192.168.100.138:9090/api/v1/query?query=up%7Bjob%3D%27offers-service%27%7D" || echo '000')
                    if [ "\$STATUS" = "200" ]; then
                        echo 'Prometheus scrape OK pour offers-service'
                    else
                        echo 'Avertissement: Prometheus ne répond pas correctement (status: '\$STATUS')'
                    fi
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} terminé avec succès - image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} échoué - vérifier les logs"
        }
    }
}
