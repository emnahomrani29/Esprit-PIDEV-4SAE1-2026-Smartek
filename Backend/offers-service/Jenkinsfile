pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        githubPush()
    }

    environment {
        SERVICE_DIR   = 'Backend/offers-service'
        IMAGE_NAME    = 'smartek/offers-service'
        IMAGE_TAG     = "${env.GIT_COMMIT?.take(7) ?: 'latest'}"

        // Nexus — stockage JAR (Maven) + registre Docker
        NEXUS_URL     = 'http://nexus:8081'
        NEXUS_REPO    = 'smartek-docker'
        NEXUS_IMAGE   = "nexus:8082/${IMAGE_NAME}:${env.GIT_COMMIT?.take(7) ?: 'latest'}"

        // SonarQube
        SONAR_PROJECT = 'offers-service'

        // Kubernetes (kubeadm / Ubuntu — pas minikube)
        K8S_NAMESPACE = 'smartek'
        K8S_DEPLOY    = 'offers-service'
    }

    stages {

        // ── 1. CHECKOUT ────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${IMAGE_TAG}"
            }
        }

        // ── 2. GIT DIFF — détecter les changements du microservice ─────
        //    Si aucun fichier de Backend/offers-service n'a changé,
        //    on skippe tout le reste (sauf sur main/develop).
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || git diff --name-only HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Fichiers modifiés :\n${changedFiles}"

                    def serviceChanged = changedFiles.split('\n').any { f ->
                        f.startsWith('Backend/offers-service/')
                    }

                    if (!serviceChanged && env.GIT_BRANCH != 'main' && env.GIT_BRANCH != 'develop') {
                        echo "⏭️  Aucun changement dans offers-service — pipeline ignoré."
                        currentBuild.result = 'NOT_BUILT'
                        error("Skipping: no changes in offers-service")
                    } else {
                        echo "✅ Changements détectés dans offers-service — pipeline lancé."
                    }
                }
            }
        }

        // ── 3. BUILD ───────────────────────────────────────────────────
        stage('Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean package -DskipTests -B'
                }
            }
        }

        // ── 4. TESTS UNITAIRES + COUVERTURE (JaCoCo) ──────────────────
        stage('Tests unitaires') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn verify -Dspring.profiles.active=test -B'
                }
            }
            post {
                always {
                    junit testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml",
                          allowEmptyResults: true
                    jacoco(
                        execPattern:   "${SERVICE_DIR}/target/jacoco.exec",
                        classPattern:  "${SERVICE_DIR}/target/classes",
                        sourcePattern: "${SERVICE_DIR}/src/main/java"
                    )
                }
            }
        }

        // ── 5. QUALITÉ DE CODE — SonarQube ─────────────────────────────
        stage('Analyse SonarQube') {
            steps {
                dir("${SERVICE_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=${SONAR_PROJECT} \
                                -Dsonar.projectName='Offers Service' \
                                -Dsonar.java.coveragePlugin=jacoco \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                                -B
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── 6. NEXUS — Stockage du JAR (Maven Repository) ─────────────
        stage('Publish JAR → Nexus') {
            steps {
                dir("${SERVICE_DIR}") {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh """
                            mvn deploy -DskipTests -B \
                                -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/smartek-releases/
                        """
                    }
                }
            }
        }

        // ── 7. DOCKER — Build de l'image ───────────────────────────────
        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        // ── 8. NEXUS — Stockage de l'image Docker ─────────────────────
        stage('Docker Push → Nexus Registry') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-credentials',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    sh """
                        echo "${NEXUS_PASS}" | docker login nexus:8082 -u "${NEXUS_USER}" --password-stdin
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${NEXUS_IMAGE}
                        docker push ${NEXUS_IMAGE}
                        docker logout nexus:8082
                    """
                }
            }
        }

        // ── 9. DÉPLOIEMENT — Kubernetes (kubeadm / Ubuntu) ────────────
        stage('Deploy → Kubernetes') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-smartek']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOY} \
                            ${K8S_DEPLOY}=${NEXUS_IMAGE} \
                            -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/${K8S_DEPLOY} \
                            -n ${K8S_NAMESPACE} \
                            --timeout=120s
                    """
                }
            }
        }

        // ── 10. SUPERVISION — vérification post-déploiement ───────────
        //     Prometheus scrape /actuator/prometheus
        //     Grafana affiche les dashboards du namespace smartek
        stage('Health Check (Prometheus)') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-smartek']) {
                    sh """
                        sleep 15
                        kubectl run probe-offers --image=curlimages/curl \
                            --restart=Never --rm -i \
                            -n ${K8S_NAMESPACE} \
                            -- curl -sf http://offers-service.${K8S_NAMESPACE}.svc.cluster.local:8085/actuator/health
                        echo "✅ Métriques Prometheus disponibles sur /actuator/prometheus"
                    """
                }
            }
        }
    }

    // ── POST ───────────────────────────────────────────────────────────
    post {
        success {
            echo "✅ Pipeline réussi — image déployée : ${NEXUS_IMAGE}"
        }
        failure {
            echo "❌ Pipeline échoué — voir les logs ci-dessus"
        }
        always {
            archiveArtifacts artifacts: "${SERVICE_DIR}/target/*.jar",
                             allowEmptyArchive: true
            cleanWs()
        }
    }
}
