pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'skill-evidence-service'
        IMAGE_NAME     = "smartek/${SERVICE_NAME}"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        CONTAINER_PORT = '8091'
        SONAR_URL      = 'http://smartek-sonarqube:9000'
        SONAR_TOKEN    = 'sqa_9666920e6bb5daeaa01417f39e831be36fac7b97'
        SONAR_PROJECT  = 'skill-evidence-service'
        NEXUS_URL      = 'http://smartek-nexus:8081'
        NEXUS_REPO     = 'maven-snapshots'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh 'mvn clean package -DskipTests --no-transfer-progress'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh 'mvn test --no-transfer-progress'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'Backend/skiil-evidence-service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh """
                        mvn sonar:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.projectName=${SONAR_PROJECT} \
                            -Dsonar.host.url=${SONAR_URL} \
                            -Dsonar.token=${SONAR_TOKEN} \
                            --no-transfer-progress
                    """
                }
            }
        }

        stage('Push to Nexus') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh """
                        mvn deploy -DskipTests \
                            -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/${NEXUS_REPO}/ \
                            -Dusername=admin -Dpassword=admin123 \
                            --no-transfer-progress
                    """
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Deploy Local') {
            steps {
                sh """
                    docker stop ${SERVICE_NAME} || true
                    docker rm   ${SERVICE_NAME} || true
                    docker stop smartek-skill-evidence || true
                    docker rm   smartek-skill-evidence || true
                    docker run -d \
                        --name ${SERVICE_NAME} \
                        --network esprit-pi-4sae1-2026-smartek_smartek-network \
                        -p ${CONTAINER_PORT}:${CONTAINER_PORT} \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} terminé avec succès - image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} échoué - vérifier les logs"
        }
    }
}
