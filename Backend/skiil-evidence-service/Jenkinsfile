pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'skill-evidence-service'
        IMAGE_NAME     = "wafachabbi/${SERVICE_NAME}"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        CONTAINER_PORT = '8091'
        SONAR_URL      = 'http://192.168.100.138:9000'
        SONAR_TOKEN    = 'squ_c9036cd8db019186d870601f11f32229205d13a2'
        SONAR_PROJECT  = 'skill-evidence-service'
        NEXUS_URL      = 'http://192.168.100.138:8089'
        NEXUS_REPO     = 'maven-snapshots'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || echo 'ALL'", returnStdout: true).trim()
                    echo "Fichiers modifiés :\n${changedFiles}"
                    if (changedFiles == 'ALL' || changedFiles.isEmpty()) {
                        echo "✅ Pas de repo Git détecté — pipeline lancé complet."
                    } else {
                        def serviceChanged = changedFiles.split('\n').any { f -> f.startsWith('Backend/skiil-evidence-service/') }
                        if (!serviceChanged && env.GIT_BRANCH != 'main' && env.GIT_BRANCH != 'develop') {
                            echo "⏭️  Aucun changement dans skill-evidence-service — pipeline ignoré."
                            currentBuild.result = 'NOT_BUILT'
                            error("Skipping: no changes in skill-evidence-service")
                        } else {
                            echo "✅ Changements détectés dans skill-evidence-service — pipeline lancé."
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh 'mvn clean package -DskipTests --no-transfer-progress'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh 'mvn test --no-transfer-progress'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'Backend/skiil-evidence-service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh """
                        mvn sonar:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.projectName=${SONAR_PROJECT} \
                            -Dsonar.host.url=${SONAR_URL} \
                            -Dsonar.token=${SONAR_TOKEN} \
                            --no-transfer-progress
                    """
                }
            }
            post {
                failure {
                    echo 'SonarQube analysis failed or server unreachable - continuing pipeline'
                }
            }
        }

        stage('Push to Nexus') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                retry(2) {
                    dir('Backend/skiil-evidence-service') {
                        sh """
                            mvn deploy -DskipTests \
                                -s /home/wafa/.jenkins/maven-settings.xml \
                                -DaltDeploymentRepository=nexus::http://192.168.100.138:8089/repository/maven-snapshots/ \
                                --no-transfer-progress
                        """
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Backend/skiil-evidence-service') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                sh """
                    echo \$DOCKERHUB_CREDENTIALS_PSW | docker login -u \$DOCKERHUB_CREDENTIALS_USR --password-stdin
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                    docker logout
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    kubectl apply -f k8s/namespace.yml
                    kubectl apply -f k8s/skill-evidence-service.yml
                    kubectl set image deployment/skill-evidence-service \
                        skill-evidence-service=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n smartek
                    kubectl rollout status deployment/skill-evidence-service \
                        -n smartek --timeout=3m
                    kubectl get pods -n smartek -l app=skill-evidence-service
                """
            }
        }

        stage('Verify Prometheus') {
            steps {
                sh """
                    echo 'Attente du démarrage du service...'
                    sleep 20
                    STATUS=\$(curl -s -o /dev/null -w '%{http_code}' http://localhost:9090/api/v1/query?query=up{job='skill-evidence-service'} || echo '000')
                    if [ "\$STATUS" = "200" ]; then
                        echo 'Prometheus scrape OK pour skill-evidence-service'
                    else
                        echo 'Avertissement: Prometheus ne répond pas correctement (status: '\$STATUS')'
                    fi
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} terminé avec succès - image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} échoué - vérifier les logs"
        }
    }
}
