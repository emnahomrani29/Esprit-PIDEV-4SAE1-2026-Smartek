# ==============================================
# SMARTEK Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ==============================================
# Twilio SMS Configuration (Planning Service)
# ==============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=true

# ==============================================
# Stripe Payment Configuration (Event Service)
# ==============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ==============================================
# File Upload Configuration (Course Service)
# ==============================================
# Maximum file size for uploads (default: 8MB)
# Increase only if necessary and ensure server resources can handle it
MAX_FILE_SIZE=8MB
MAX_REQUEST_SIZE=8MB

# ==============================================
# Database Configuration (All Services)
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ==============================================
# JWT Configuration (All Services)
# ==============================================
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# ==============================================
# Mail Configuration (Certification Service)
# ==============================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@smartek.com

# ==============================================
# Monitoring Configuration
# ==============================================
GRAFANA_PASSWORD=your_grafana_admin_password_here

# Alertmanager - Email notifications
ALERT_EMAIL_USER=your_alert_email@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here
