pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    triggers {
        // Polling SCM - vérifie le repo toutes les 5 minutes
        pollSCM('H/5 * * * *')
    }

    environment {
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('🔍 Checkout') {
            steps {
                echo "📥 Cloning repository..."
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                }
                echo "✅ Commit: ${env.GIT_COMMIT_SHORT}"
            }
        }

        stage('📦 Install Dependencies') {
            steps {
                dir('Frontend/angular-app') {
                    echo "📦 Installing npm dependencies..."
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci --prefer-offline --no-audit --legacy-peer-deps'
                    echo "✅ Dependencies installed"
                }
            }
        }

        stage('🏗️ Build Production') {
            steps {
                dir('Frontend/angular-app') {
                    echo "🏗️ Building Angular app..."
                    sh 'npm run build -- --configuration production || npm run build'
                    echo "✅ Build completed"
                }
            }
        }

        stage('📊 SonarQube Analysis') {
            steps {
                dir('Frontend/angular-app') {
                    echo "📊 Running SonarQube analysis..."
                    withSonarQubeEnv('SonarCloud') {
                        sh """
                            npx sonar-scanner \
                                -Dsonar.projectKey=rahmaba17_smartek-frontend \
                                -Dsonar.projectName="Smartek - Frontend" \
                                -Dsonar.organization=rahmaba17 \
                                -Dsonar.sources=src \
                                -Dsonar.exclusions="src/**/*.spec.ts,src/environments/**,node_modules/**,dist/**" \
                                -Dsonar.host.url=https://sonarcloud.io \
                                -Dsonar.token=${SONAR_TOKEN}
                        """
                    }
                    echo "✅ SonarQube analysis completed"
                }
            }
        }

        stage('� Archive Artifacts') {
            steps {
                dir('Frontend/angular-app') {
                    echo "📦 Archiving build artifacts..."
                    archiveArtifacts artifacts: 'dist/**/*', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        success {
            echo "✅ Frontend Pipeline completed successfully!"
            echo "🔖 Commit: ${env.GIT_COMMIT_SHORT}"
        }
        failure {
            echo "❌ Frontend Pipeline failed!"
        }
        always {
            echo "🧹 Pipeline finished."
        }
    }
}
