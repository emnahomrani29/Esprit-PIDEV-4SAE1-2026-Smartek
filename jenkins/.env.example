# ============================================================
# Variables d'environnement pour la stack Jenkins/SonarQube
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env dans Git !
# ============================================================

# Jenkins
JENKINS_ADMIN_PASSWORD=admin123

# Docker Registry (Docker Hub ou registry privé)
DOCKER_USERNAME=ton-username
DOCKER_PASSWORD=ton-token-dockerhub

# SonarQube (générer depuis http://localhost:9000 → My Account → Security)
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub (Personal Access Token avec droits repo)
GITHUB_USERNAME=ton-username-github
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
