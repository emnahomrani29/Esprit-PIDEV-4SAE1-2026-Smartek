// ============================================================
// Pipeline Jenkins - auth-service
// ============================================================
pipeline {
    agent any

    environment {
        SERVICE_NAME  = 'auth-service'
        SERVICE_PATH  = 'Backend/auth-service'
        IMAGE_NAME    = 'smartek/auth-service'
        IMAGE_TAG     = "${BUILD_NUMBER}"
        SONAR_PROJECT = 'smartek-auth-service'
        MVN           = '/usr/share/maven/bin/mvn'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        stage('Build & Test') {
            steps {
                dir("${env.SERVICE_PATH}") {
                    sh "${env.MVN} clean verify -Pcoverage --no-transfer-progress -Dspring.profiles.active=test"
                }
            }
            post {
                always {
                    junit testResults: "${env.SERVICE_PATH}/target/surefire-reports/*.xml",
                          allowEmptyResults: true
                    jacoco execPattern: "${env.SERVICE_PATH}/target/jacoco.exec",
                           classPattern: "${env.SERVICE_PATH}/target/classes",
                           sourcePattern: "${env.SERVICE_PATH}/src/main/java"
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build \\\\
                        --build-arg BUILD_DATE=\\\2026-05-14T23:28:42Z \\\\
                        --build-arg VERSION=${env.IMAGE_TAG} \\\\
                        -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} \\\\
                        -t ${env.IMAGE_NAME}:latest \\\\
                        ${env.SERVICE_PATH}
                """
            }
        }

        stage('Docker Push') {
            when { branch pattern: 'main|develop', comparator: 'REGEXP' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-registry-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo \\\ | docker login -u \\\ --password-stdin
                        docker push ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                        docker push ${env.IMAGE_NAME}:latest
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                sh "docker rmi smartek/auth-service:${BUILD_NUMBER} || true"
            }
            deleteDir()
        }
        success { echo "? auth-service build #${BUILD_NUMBER} succeeded" }
        failure { echo "? auth-service build #${BUILD_NUMBER} failed" }
    }
}