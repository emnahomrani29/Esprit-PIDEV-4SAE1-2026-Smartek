// ============================================================
// Pipeline Jenkins GLOBAL - Smartek Platform
// Orchestre le build de tous les microservices + frontend
// en parallèle, puis déploie dans l'ordre correct.
// ============================================================
pipeline {
    agent any

    parameters {
        booleanParam(name: 'SKIP_TESTS',   defaultValue: false, description: 'Passer les tests (build rapide)')
        booleanParam(name: 'PUSH_IMAGES',  defaultValue: true,  description: 'Pousser les images vers le registry')
        booleanParam(name: 'DEPLOY',       defaultValue: false, description: 'Déployer après le build (Docker Swarm)')
        string(name:  'IMAGE_TAG',         defaultValue: '',    description: 'Tag image (vide = numéro de build)')
        choice(name:  'ENVIRONMENT',       choices: ['dev', 'staging', 'prod'], description: 'Environnement cible')
    }

    environment {
        DOCKER_REGISTRY = 'smartek'
        TAG             = "${params.IMAGE_TAG ?: BUILD_NUMBER}"
        BUILD_DATE      = sh(script: "date -u +%Y-%m-%dT%H:%M:%SZ", returnStdout: true).trim()
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────────
        // 1. CHECKOUT
        // ─────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "🔀 Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)} | Tag: ${TAG}"
            }
        }

        // ─────────────────────────────────────────────────────────
        // 2. INFRASTRUCTURE SERVICES (séquentiel – dépendances)
        // ─────────────────────────────────────────────────────────
        stage('Infrastructure Services') {
            parallel {
                stage('config-server') {
                    steps { script { buildService('config-server', 'Backend/config-server', true) } }
                }
                stage('eureka-server') {
                    steps { script { buildService('eureka-server', 'Backend/eureka-server', true) } }
                }
            }
        }

        // ─────────────────────────────────────────────────────────
        // 3. BACKEND SERVICES (parallèle)
        // ─────────────────────────────────────────────────────────
        stage('Backend Services') {
            parallel {
                stage('auth-service') {
                    steps { script { buildService('auth-service', 'Backend/auth-service') } }
                }
                stage('api-gateway') {
                    steps { script { buildService('api-gateway', 'Backend/api-gateway') } }
                }
                stage('event-service') {
                    steps { script { buildService('event-service', 'Backend/event-service') } }
                }
                stage('planning-service') {
                    steps { script { buildService('planning-service', 'Backend/planning-service') } }
                }
                stage('training-service') {
                    steps { script { buildService('training-service', 'Backend/training-service') } }
                }
                stage('offers-service') {
                    steps { script { buildService('offers-service', 'Backend/offers-service') } }
                }
                stage('course-service') {
                    steps { script { buildService('course-service', 'Backend/course-service') } }
                }
                stage('exam-service') {
                    steps { script { buildService('exam-service', 'Backend/exam-service') } }
                }
                stage('skill-evidence-service') {
                    steps { script { buildService('skill-evidence-service', 'Backend/skiil-evidence-service') } }
                }
                stage('learning-service') {
                    steps { script { buildService('learning-service', 'Backend/learning') } }
                }
                stage('sponsor-service') {
                    steps { script { buildService('sponsor-service', 'Backend/smartek_sponsor') } }
                }
                stage('certification-badge-service') {
                    steps { script { buildService('certification-badge-service', 'Backend/certification-badge-service') } }
                }
            }
        }

        // ─────────────────────────────────────────────────────────
        // 4. FRONTEND (parallèle avec backend)
        // ─────────────────────────────────────────────────────────
        stage('Frontend') {
            steps {
                script { buildFrontend() }
            }
        }

        // ─────────────────────────────────────────────────────────
        // 5. PUSH IMAGES
        // ─────────────────────────────────────────────────────────
        stage('Push Images') {
            when {
                allOf {
                    expression { params.PUSH_IMAGES }
                    branch pattern: 'main|develop', comparator: 'REGEXP'
                }
            }
            steps {
                script {
                    def services = [
                        'config-server', 'eureka-server',
                        'auth-service', 'api-gateway', 'event-service',
                        'planning-service', 'training-service', 'offers-service',
                        'course-service', 'exam-service', 'skill-evidence-service',
                        'learning-service', 'sponsor-service', 'certification-badge-service',
                        'angular-app'
                    ]
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-registry-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                        services.each { svc ->
                            sh """
                                docker push ${DOCKER_REGISTRY}/${svc}:${TAG}
                                docker push ${DOCKER_REGISTRY}/${svc}:latest
                            """
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────
        // 6. DEPLOY (optionnel)
        // ─────────────────────────────────────────────────────────
        stage('Deploy') {
            when { expression { params.DEPLOY } }
            steps {
                script {
                    echo "🚀 Deploying to ${params.ENVIRONMENT}..."
                    def services = [
                        'config-server', 'eureka-server',
                        'auth-service', 'api-gateway', 'event-service',
                        'planning-service', 'training-service', 'offers-service',
                        'course-service', 'exam-service', 'skill-evidence-service',
                        'learning-service', 'sponsor-service', 'certification-badge-service',
                        'angular-app'
                    ]
                    services.each { svc ->
                        def swarmName = svc == 'angular-app' ? 'frontend' : svc
                        sh """
                            docker service update \
                                --image ${DOCKER_REGISTRY}/${svc}:${TAG} \
                                smartek_${swarmName} || \
                            echo "⚠️  ${svc} not in swarm – skipping"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Nettoyage des images locales
                def services = [
                    'config-server', 'eureka-server', 'auth-service', 'api-gateway',
                    'event-service', 'planning-service', 'training-service', 'offers-service',
                    'course-service', 'exam-service', 'skill-evidence-service',
                    'learning-service', 'sponsor-service', 'certification-badge-service',
                    'angular-app'
                ]
                services.each { svc ->
                    sh "docker rmi ${DOCKER_REGISTRY}/${svc}:${TAG} || true"
                }
            }
            cleanWs()
        }
        success {
            echo """
            ╔══════════════════════════════════════════════════╗
            ║  ✅ SMARTEK PLATFORM BUILD SUCCEEDED             ║
            ║  Build #${BUILD_NUMBER} | Tag: ${TAG}
            ╚══════════════════════════════════════════════════╝
            """
        }
        failure {
            echo """
            ╔══════════════════════════════════════════════════╗
            ║  ❌ SMARTEK PLATFORM BUILD FAILED                ║
            ║  Build #${BUILD_NUMBER} | Check logs above
            ╚══════════════════════════════════════════════════╝
            """
        }
    }
}

// ─────────────────────────────────────────────────────────────
// FONCTIONS UTILITAIRES
// ─────────────────────────────────────────────────────────────

def buildService(String serviceName, String servicePath, boolean skipTests = false) {
    def skipTestsFlag = (params.SKIP_TESTS || skipTests) ? '-DskipTests' : '-Pcoverage'
    dir(servicePath) {
        sh "mvn clean package ${skipTestsFlag} --no-transfer-progress"
    }
    sh """
        docker build \\
            --build-arg BUILD_DATE=${BUILD_DATE} \\
            --build-arg VERSION=${TAG} \\
            -t ${DOCKER_REGISTRY}/${serviceName}:${TAG} \\
            -t ${DOCKER_REGISTRY}/${serviceName}:latest \\
            ${servicePath}
    """
    // Scan sécurité (non bloquant)
    sh "trivy image --exit-code 0 --severity HIGH,CRITICAL --format table ${DOCKER_REGISTRY}/${serviceName}:${TAG} || true"
    echo "✅ ${serviceName} built successfully"
}

def buildFrontend() {
    dir('Frontend/angular-app') {
        sh 'npm ci --prefer-offline'
        if (!params.SKIP_TESTS) {
            sh '''
                npm run test -- \
                    --no-watch \
                    --no-progress \
                    --browsers=ChromeHeadless \
                    --code-coverage || true
            '''
        }
        sh 'npm run build -- --configuration production'
    }
    sh """
        docker build \\
            --build-arg BUILD_DATE=${BUILD_DATE} \\
            --build-arg VERSION=${TAG} \\
            -t ${DOCKER_REGISTRY}/angular-app:${TAG} \\
            -t ${DOCKER_REGISTRY}/angular-app:latest \\
            Frontend/angular-app
    """
    sh "trivy image --exit-code 0 --severity HIGH,CRITICAL --format table ${DOCKER_REGISTRY}/angular-app:${TAG} || true"
    echo "✅ Frontend built successfully"
}
