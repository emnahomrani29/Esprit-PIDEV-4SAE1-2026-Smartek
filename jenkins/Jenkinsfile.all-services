// ============================================================
// Pipeline Jenkins GLOBAL - Smartek Platform
// Build tous les microservices + frontend en parallèle
// ============================================================
pipeline {
    agent any

    parameters {
        booleanParam(name: 'SKIP_TESTS',  defaultValue: false, description: 'Passer tous les tests')
        booleanParam(name: 'PUSH_IMAGES', defaultValue: false, description: 'Pousser les images vers le registry')
        booleanParam(name: 'DEPLOY',      defaultValue: false, description: 'Déployer après le build')
        string(name:  'IMAGE_TAG',        defaultValue: '',    description: 'Tag image (vide = numéro de build)')
    }

    environment {
        REGISTRY = 'smartek'
        TAG      = "${params.IMAGE_TAG ?: BUILD_NUMBER}"
        MVN      = '/usr/share/maven/bin/mvn'
        // Exclure les tests nécessitant MySQL
        TEST_EXCLUDES = '**/repository/**,**/integration/**'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)} | Tag: ${TAG}"
            }
        }

        // ── Infrastructure (config + eureka) ──────────────────
        stage('Infrastructure') {
            parallel {
                stage('config-server') {
                    steps { script { buildService('config-server', 'Backend/config-server', true) } }
                }
                stage('eureka-server') {
                    steps { script { buildService('eureka-server', 'Backend/eureka-server', true) } }
                }
            }
        }

        // ── Backend (tous en parallèle) ────────────────────────
        stage('Backend') {
            parallel {
                stage('auth-service') {
                    steps { script { buildService('auth-service', 'Backend/auth-service') } }
                }
                stage('api-gateway') {
                    steps { script { buildService('api-gateway', 'Backend/api-gateway') } }
                }
                stage('event-service') {
                    steps { script { buildService('event-service', 'Backend/event-service') } }
                }
                stage('planning-service') {
                    steps { script { buildService('planning-service', 'Backend/planning-service') } }
                }
                stage('training-service') {
                    steps { script { buildService('training-service', 'Backend/training-service') } }
                }
                stage('offers-service') {
                    steps { script { buildService('offers-service', 'Backend/offers-service') } }
                }
                stage('course-service') {
                    steps { script { buildService('course-service', 'Backend/course-service') } }
                }
                stage('exam-service') {
                    steps { script { buildService('exam-service', 'Backend/exam-service') } }
                }
                stage('skill-evidence-service') {
                    steps { script { buildService('skill-evidence-service', 'Backend/skiil-evidence-service') } }
                }
                stage('learning-service') {
                    steps { script { buildService('learning-service', 'Backend/learning') } }
                }
                stage('sponsor-service') {
                    steps { script { buildService('sponsor-service', 'Backend/smartek_sponsor') } }
                }
                stage('certification-badge-service') {
                    steps { script { buildService('certification-badge-service', 'Backend/certification-badge-service') } }
                }
            }
        }

        // ── Frontend ───────────────────────────────────────────
        stage('Frontend') {
            steps { script { buildFrontend() } }
        }

        // ── Push images ────────────────────────────────────────
        stage('Push Images') {
            when {
                allOf {
                    expression { params.PUSH_IMAGES }
                    branch pattern: 'main|develop', comparator: 'REGEXP'
                }
            }
            steps {
                script {
                    def services = [
                        'config-server', 'eureka-server',
                        'auth-service', 'api-gateway', 'event-service',
                        'planning-service', 'training-service', 'offers-service',
                        'course-service', 'exam-service', 'skill-evidence-service',
                        'learning-service', 'sponsor-service', 'certification-badge-service',
                        'angular-app'
                    ]
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-registry-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        services.each { svc ->
                            sh "docker push ${REGISTRY}/${svc}:${TAG}"
                            sh "docker push ${REGISTRY}/${svc}:latest"
                        }
                    }
                }
            }
        }

        // ── Deploy (optionnel) ─────────────────────────────────
        stage('Deploy') {
            when { expression { params.DEPLOY } }
            steps {
                script {
                    def services = [
                        'config-server', 'eureka-server',
                        'auth-service', 'api-gateway', 'event-service',
                        'planning-service', 'training-service', 'offers-service',
                        'course-service', 'exam-service', 'skill-evidence-service',
                        'learning-service', 'sponsor-service', 'certification-badge-service',
                        'angular-app'
                    ]
                    services.each { svc ->
                        def swarmName = svc == 'angular-app' ? 'frontend' : svc
                        sh "docker service update --image ${REGISTRY}/${svc}:${TAG} smartek_${swarmName} || echo 'Skipping ${svc}'"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def services = [
                    'config-server', 'eureka-server', 'auth-service', 'api-gateway',
                    'event-service', 'planning-service', 'training-service', 'offers-service',
                    'course-service', 'exam-service', 'skill-evidence-service',
                    'learning-service', 'sponsor-service', 'certification-badge-service',
                    'angular-app'
                ]
                services.each { svc ->
                    sh "docker rmi ${REGISTRY}/${svc}:${TAG} || true"
                }
            }
            deleteDir()
        }
        success { echo "✅ Smartek Platform build #${BUILD_NUMBER} succeeded (tag: ${TAG})" }
        failure { echo "❌ Smartek Platform build #${BUILD_NUMBER} failed" }
    }
}

// ─────────────────────────────────────────────────────────────
// Fonctions utilitaires
// ─────────────────────────────────────────────────────────────

def buildService(String name, String path, boolean infraOnly = false) {
    def mvn = env.MVN
    def tag = env.TAG
    def registry = env.REGISTRY
    def excludes = env.TEST_EXCLUDES

    dir(path) {
        if (params.SKIP_TESTS || infraOnly) {
            sh "${mvn} clean package -DskipTests --no-transfer-progress"
        } else {
            sh "${mvn} clean verify --no-transfer-progress -Dspring.profiles.active=test -Dmaven.test.failure.ignore=true -Dexclude='${excludes}'"
        }
    }

    sh "docker build -t ${registry}/${name}:${tag} -t ${registry}/${name}:latest ${path}"
    echo "✅ ${name} built"
}

def buildFrontend() {
    def tag = env.TAG
    def registry = env.REGISTRY

    dir('Frontend/angular-app') {
        sh 'npm ci --prefer-offline'
        if (!params.SKIP_TESTS) {
            sh 'npm run lint || true'
        }
        sh 'npm run build -- --configuration production'
    }

    sh "docker build -t ${registry}/angular-app:${tag} -t ${registry}/angular-app:latest Frontend/angular-app"
    echo "✅ Frontend built"
}
