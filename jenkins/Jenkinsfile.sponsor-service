// Pipeline Jenkins - sponsor-service
pipeline {
    agent any

    environment {
        SERVICE_PATH  = 'Backend/smartek_sponsor'
        IMAGE_NAME    = 'smartek/sponsor-service'
        MVN           = '/usr/share/maven/bin/mvn'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        // Prevent Jenkins from trying to resume a build after a controller restart.
        // Without this, the pipeline resumes mid-stage but loses the node/workspace
        // context, causing MissingContextVariableException on junit/sh steps.
        skipDefaultCheckout(false)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        stage('Build & Test') {
            steps {
                dir("${env.SERVICE_PATH}") {
                    // -Pci excludes tests that require a real MySQL database
                    sh "${env.MVN} clean verify --no-transfer-progress -Pci -Dspring.profiles.active=test -Dmaven.test.failure.ignore=true"
                }
            }
            post {
                always {
                    // Wrap in node to guarantee workspace context is available,
                    // even if the stage post runs after a controller restart
                    node('built-in') {
                        junit testResults: "${env.SERVICE_PATH}/target/surefire-reports/*.xml",
                              allowEmptyResults: true
                        jacoco execPattern: "${env.SERVICE_PATH}/target/jacoco.exec",
                               classPattern: "${env.SERVICE_PATH}/target/classes",
                               sourcePattern: "${env.SERVICE_PATH}/src/main/java"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${env.IMAGE_NAME}:${BUILD_NUMBER} -t ${env.IMAGE_NAME}:latest ${env.SERVICE_PATH}"
            }
        }

        stage('Docker Push') {
            when { branch pattern: 'main|develop', comparator: 'REGEXP' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-registry-credentials',
                                                  usernameVariable: 'DOCKER_USER',
                                                  passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker push ${env.IMAGE_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${env.IMAGE_NAME}:latest"
                }
            }
        }
    }

    post {
        always {
            sh "docker rmi ${env.IMAGE_NAME}:${BUILD_NUMBER} || true"
            sh "docker rmi ${env.IMAGE_NAME}:latest || true"
            deleteDir()
        }
        success { echo "✅ sponsor-service build #${BUILD_NUMBER} succeeded" }
        failure { echo "❌ sponsor-service build #${BUILD_NUMBER} failed" }
    }
}
