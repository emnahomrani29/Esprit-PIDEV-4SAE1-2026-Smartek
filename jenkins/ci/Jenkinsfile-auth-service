pipeline {
    agent any

    environment {
        AUTH_DIR     = 'Backend/auth-service'
        IMAGE_PREFIX = 'smartek'
        VM_IP        = '192.168.1.100'
        NEXUS_URL    = "http://${VM_IP}:8081"
        NEXUS_REPO   = 'smartek-releases'
    }

    tools {
        maven 'Maven-3.9'
        jdk 'JDK17'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || git diff --name-only HEAD',
                        returnStdout: true
                    ).trim()
                    echo "Changed files:\n${changedFiles}"
                    if (!changedFiles.contains('Backend/auth-service/')) {
                        echo "No changes in auth-service. Skipping pipeline."
                        currentBuild.result = 'SUCCESS'
                        error('No changes detected in auth-service')
                    }
                }
            }
        }

        stage('Build & Test') {
            steps {
                dir("${AUTH_DIR}") {
                    sh 'mvn clean verify -B'
                }
            }
            post {
                always {
                    junit "${AUTH_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Publish JAR to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-credentials',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    dir("${AUTH_DIR}") {
                        sh """
                            mvn deploy -DskipTests -B \
                                -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/${NEXUS_REPO}/
                        """
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        def image = docker.build(
                            "${DOCKER_USER}/${IMAGE_PREFIX}-auth-service:${BUILD_NUMBER}",
                            "${AUTH_DIR}"
                        )
                        docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                            image.push()
                            image.push('latest')
                        }
                    }
                }
            }
        }

        stage('Update K8s Manifest Tag') {
            steps {
                sh """
                    sed -i "s|<DOCKER_HUB_USER>.*\\/${IMAGE_PREFIX}-auth-service:.*|<DOCKER_HUB_USER>\\/${IMAGE_PREFIX}-auth-service:${BUILD_NUMBER}|g" \
                        k8s/apps/auth-service/auth-service-deployment.yaml
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            build job: 'smartek-auth-service-cd', wait: false
        }
        failure {
            echo 'Auth Service CI failed — CD will not be triggered.'
        }
    }
}
