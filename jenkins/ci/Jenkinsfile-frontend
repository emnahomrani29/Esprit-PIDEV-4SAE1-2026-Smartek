pipeline {
    agent any

    environment {
        FRONTEND_DIR = 'Frontend/angular-app'
        IMAGE_PREFIX = 'smartek'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || git diff --name-only HEAD',
                        returnStdout: true
                    ).trim()
                    echo "Changed files:\n${changedFiles}"
                    if (!changedFiles.contains('Frontend/angular-app/')) {
                        echo "No changes in frontend. Skipping pipeline."
                        currentBuild.result = 'SUCCESS'
                        error('No changes detected in frontend')
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        def image = docker.build(
                            "${DOCKER_USER}/${IMAGE_PREFIX}-frontend:${BUILD_NUMBER}",
                            "${FRONTEND_DIR}"
                        )
                        docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                            image.push()
                            image.push('latest')
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            build job: 'smartek-frontend-cd', wait: false
        }
        failure {
            echo 'Frontend CI failed — CD will not be triggered.'
        }
    }
}
